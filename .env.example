# ==============================================================================
# 0. SECRETS LOCATION — EXTERNAL ENVIRONMENT DIRECTORY
# ==============================================================================
# DO NOT store real secrets inside this project folder if it is synced by
# OneDrive, Dropbox, Google Drive, or any cloud-sync service.
#
# To load env from outside the project tree, set the WASEL_ENV_DIR environment
# variable before starting the dev server or building:
#
#   PowerShell:  $env:WASEL_ENV_DIR="$env:USERPROFILE\.wasel-secrets"
#   Bash:        export WASEL_ENV_DIR="$HOME/.wasel-secrets"
#   Vercel:      Project Settings → Environment Variables → WASEL_ENV_DIR
#
# Place your real .env file in that directory. Vite will load .env,
# .env.local, .env.production, etc. from there instead of the project root.
#
# On Windows, create the directory once:
#   mkdir $env:USERPROFILE\.wasel-secrets
#   Copy your real .env into that directory.
#   Replace the contents of this project's .env with placeholders only.
# ==============================================================================

# ==============================================================================
# WASEL — ENVIRONMENT CONFIGURATION
# ==============================================================================
# PURPOSE
# ------------------------------------------------------------------------------
# Central environment variable template for the Wasel platform.
#
# FILE USAGE
# ------------------------------------------------------------------------------
# .env.example  → Safe template committed to Git. NO real secrets.
# .env.local    → Local development secrets. NEVER commit.
# Production    → Configure secrets in Vercel / Supabase Edge Function Secrets.
#
# SECURITY RULES
# ------------------------------------------------------------------------------
# 1. VITE_* variables are PUBLIC and available in the browser.
# 2. NEVER place server secrets in VITE_* variables.
# 3. NEVER commit real production secrets to Git.
# 4. Restrict browser API keys at the provider level.
# 5. Use separate credentials for development, staging, and production.
# 6. Rotate any secret that has ever been accidentally exposed.
# ==============================================================================

# ==============================================================================
# 1. ENVIRONMENT
# ==============================================================================
APP_ENV=production
LOG_LEVEL=info

# ==============================================================================
# 2. APPLICATION
# ==============================================================================
VITE_APP_NAME=Wasel

# Canonical production URL
VITE_APP_URL=https://www.wasel14.online
# Read as a fallback by scripts/verify-oauth-config.mjs when VITE_APP_URL is unset.
VITE_APP_ORIGIN=https://www.wasel14.online

# Legacy apex origin (https://wasel14.online, no www). Needed by the Edge Function
# CORS allowlist (ALLOWED_ORIGINS), not by the client bundle, so it is intentionally
# NOT VITE_-prefixed here.

# Server-side canonical base URL
APP_BASE_URL=https://www.wasel14.online

# Set automatically by CI/CD when possible.
VITE_APP_VERSION=

# ==============================================================================
# 3. SUPABASE — PUBLIC BROWSER CONFIGURATION
# ==============================================================================
# These values are intentionally available to the browser.
# Supabase authorization security must be enforced through RLS policies.
# ==============================================================================
VITE_SUPABASE_URL=https://zexlxabdcsjefptmjhuq.supabase.co

# Primary modern Supabase browser key.
VITE_SUPABASE_PUBLISHABLE_KEY=PASTE_YOUR_SUPABASE_PUBLISHABLE_KEY_HERE

# ==============================================================================
# 4. SUPABASE — LEGACY CLIENT COMPATIBILITY
# ==============================================================================
# Keep ONLY while application code still uses import.meta.env.VITE_SUPABASE_ANON_KEY.
# If unused, remove this variable and migrate all clients to VITE_SUPABASE_PUBLISHABLE_KEY.
# ==============================================================================
VITE_SUPABASE_ANON_KEY=PASTE_YOUR_SUPABASE_ANON_KEY_HERE

# ==============================================================================
# 5. SUPABASE — SERVER ONLY
# ==============================================================================
# NEVER expose these variables through VITE_*.
# In Vercel, set these in Project Settings → Environment Variables (Server-side only).
# ==============================================================================
SUPABASE_SECRET_KEY=PASTE_YOUR_SUPABASE_SECRET_KEY_HERE

# Direct Postgres connection string. Server-only. Never expose via VITE_*.
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.zexlxabdcsjefptmjhuq.supabase.co:5432/postgres

# Legacy compatibility only. Remove after migration if not required.
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Legacy JWT secret. Leave empty unless explicitly required by backend code.
SUPABASE_JWT_SECRET=PASTE_YOUR_SUPABASE_JWT_SECRET_HERE

# Public endpoint used for JWT/JWKS verification.
SUPABASE_JWKS_URL=https://zexlxabdcsjefptmjhuq.supabase.co/auth/v1/.well-known/jwks.json
# Supabase OAuth 2.1 / OIDC server endpoints (project zexlxabdcsjefptmjhuq):
#   Authorization: https://zexlxabdcsjefptmjhuq.supabase.co/auth/v1/oauth/authorize
#   Token:         https://zexlxabdcsjefptmjhuq.supabase.co/auth/v1/oauth/token
#   OIDC discovery: https://zexlxabdcsjefptmjhuq.supabase.co/auth/v1/.well-known/openid-configuration

# ==============================================================================
# 6. SUPABASE EDGE FUNCTIONS
# ==============================================================================
VITE_EDGE_FUNCTIONS_BASE_URL=https://zexlxabdcsjefptmjhuq.supabase.co/functions/v1

# Optional. Leave empty to use the default function name from config.
VITE_EDGE_FUNCTION_NAME=make-server-0b1f4071

# Deprecated: no code reads VITE_DATA_PATH. The API base is derived from
# VITE_EDGE_FUNCTIONS_BASE_URL + VITE_EDGE_FUNCTION_NAME (src/services/core/api-resolver.ts).
# Kept only so existing Vercel env sets stop erroring. Safe to delete everywhere.
VITE_DATA_PATH=edge

# ==============================================================================
# 7. APPLICATION API
# ==============================================================================
# Leave empty to derive from VITE_EDGE_FUNCTIONS_BASE_URL + VITE_EDGE_FUNCTION_NAME.
# Setting it explicitly overrides that derivation (src/services/core/api-resolver.ts).
VITE_API_URL=

# ==============================================================================
# 8. GOOGLE MAPS — PUBLIC BROWSER KEY
# ==============================================================================
# Restrict this key by HTTP referrers, production domains, and required Google APIs only.
VITE_GOOGLE_MAPS_API_KEY=PASTE_YOUR_GOOGLE_MAPS_API_KEY_HERE

# ==============================================================================
# 9. OAUTH — PUBLIC CLIENT CONFIGURATION
# ==============================================================================
# NOTE: VITE_GOOGLE_CLIENT_ID / VITE_FACEBOOK_APP_ID are NOT read by the web app
# (Supabase Auth runs the OAuth flow server-side via supabase-js signInWithOAuth).
# They are kept only because some deploy scripts copy them to Vercel.
# The real OAuth credentials are the SUPABASE_AUTH_* values below — read by Supabase,
# never exposed to the browser. Do NOT rely on the VITE_* vars for login to work.
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
VITE_FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
# Client-side callback, served by the SPA (src/pages/WaselAuthCallback.tsx) and
# rewritten to index.html in vercel.json. `vite dev` cannot run /api functions, so
# this is the value used in local AND production envs. Only switch to
# /api/auth/callback (api/auth/callback.ts) for a server-side exchange deployment.
VITE_AUTH_CALLBACK_PATH=/app/auth/callback

# ------------------------------------------------------------------------------
# REQUIRED PROVIDER-SIDE REDIRECT URI (the #1 cause of a dead login button)
# ------------------------------------------------------------------------------
# The browser never talks to Google/Facebook directly. It goes to
# supabase.co/auth/v1/authorize, which 302s to the provider with THIS uri as
# `redirect_uri`, and then back here once the provider returns the code:
#
#   https://<project-ref>.supabase.co/auth/v1/callback
#   i.e. https://zexlxabdcsjefptmjhuq.supabase.co/auth/v1/callback
#
# It must be registered in BOTH provider consoles, verbatim:
#   Google   → APIs & Services → Credentials → the OAuth client above
#              → Authorized redirect URIs
#   Facebook → Facebook for Developers → Settings → Valid OAuth Redirect URIs
#
# If it is missing the provider answers `redirect_uri_mismatch` and the user is
# stranded on the provider's error page before this app ever sees a response.
# VITE_APP_URL / VITE_AUTH_CALLBACK_PATH (above) are NOT what the provider sees:
# Supabase only forwards them to the app as `redirect_to` after the code returns.
# Also add the app's own URLs to Supabase → Authentication → URL Configuration →
# Redirect URLs, otherwise the code never comes back to /app/auth/callback.

# ==============================================================================
# 10. OAUTH — SERVER ONLY
# ==============================================================================
# In Vercel, set these in Project Settings → Environment Variables (Server-side only).
# ==============================================================================
SUPABASE_AUTH_GOOGLE_CLIENT_ID=631682127784-4n5b1g3mo934bp3jnm7501i9d60t2im2.apps.googleusercontent.com
SUPABASE_AUTH_GOOGLE_CLIENT_SECRET=PASTE_YOUR_GOOGLE_CLIENT_SECRET_HERE
SUPABASE_AUTH_FACEBOOK_CLIENT_ID=2154021471813673
SUPABASE_AUTH_FACEBOOK_CLIENT_SECRET=PASTE_YOUR_FACEBOOK_APP_SECRET_HERE

# OAuth provider-specific settings (set in Supabase Dashboard → Authentication → Providers).
# Google: skip_nonce_check=false, email_optional=true
# Facebook: skip_nonce_check=false, email_optional=true
GOOGLE_OAUTH_ENABLED=true
GOOGLE_OAUTH_SKIP_NONCE_CHECKS=false
GOOGLE_OAUTH_ALLOW_USERS_WITHOUT_EMAIL=true
GOOGLE_OAUTH_REQUIRE_VERIFIED_EMAIL=false
FACEBOOK_OAUTH_ENABLED=true
FACEBOOK_OAUTH_ALLOW_USERS_WITHOUT_EMAIL=true
FACEBOOK_OAUTH_REQUIRE_EMAIL_WHEN_PROVIDER_SUPPORTS_IT=false

# ==============================================================================
# 11. SUPPORT CONTACTS
# ==============================================================================
# WhatsApp integrations generally expect digits only.
VITE_SUPPORT_WHATSAPP_NUMBER=962790000000
VITE_SUPPORT_EMAIL=support@wasel.jo

# E.164 format.
VITE_SUPPORT_PHONE_NUMBER=+962790000000
VITE_SUPPORT_SMS_NUMBER=+962790000000

# ==============================================================================
# 12. FEATURE FLAGS — PRODUCTION
# ==============================================================================
# Two-factor authentication (TOTP + backup codes).
# Backend endpoints are live: /v1/auth/2fa/setup, /v1/auth/2fa/verify, /v1/auth/2fa/disable
# Set VITE_ENABLE_TWO_FACTOR_AUTH=true to expose the 2FA UI to users.
# Set VITE_ENFORCE_TWO_FACTOR_AUTH=true to require 2FA for payments and sensitive operations.
VITE_ENABLE_TWO_FACTOR_AUTH=true
VITE_ENFORCE_TWO_FACTOR_AUTH=false
VITE_ENABLE_EMAIL_NOTIFICATIONS=true
VITE_ENABLE_SMS_NOTIFICATIONS=true
VITE_ENABLE_WHATSAPP_NOTIFICATIONS=true

# Production safety flags.
VITE_ENABLE_DEMO_DATA=false
VITE_ENABLE_SYNTHETIC_TRIPS=false
VITE_ALLOW_DIRECT_SUPABASE_FALLBACK=false

# ==============================================================================
# 12b. E2E / LOCAL TESTING — NOT used in production
# ==============================================================================
# VITE_E2E_LOCAL_AUTH bypasses OAuth in Playwright E2E runs. Must NOT be 'true'
# in production (runtimeConfigGuard.ts rejects it for non-dev builds).
VITE_E2E_LOCAL_AUTH=
# Local dev user key in localStorage (default: wasel_user_session). Override only
# if the storage key has been changed in code.
VITE_LOCAL_AUTH_STORAGE_KEY=wasel_user_session
# Demo ride data toggle for development/testing only. Keep 'false' in production.
VITE_ENABLE_DEMO_RIDES=false

# ==============================================================================
# 13. STRIPE — PUBLIC
# ==============================================================================
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_PASTE_YOUR_STRIPE_PUBLISHABLE_KEY_HERE

# ==============================================================================
# 14. STRIPE — SERVER ONLY
# ==============================================================================
# In Vercel, set these in Project Settings → Environment Variables (Server-side only).
STRIPE_SECRET_KEY=sk_live_PASTE_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_PASTE_YOUR_STRIPE_WEBHOOK_SECRET_HERE

# Validate against the installed Stripe SDK before enabling.
STRIPE_API_VERSION=2026-02-25.clover

# Stripe Billing price for the Wasel Plus monthly subscription.
STRIPE_WASEL_PLUS_PRICE_ID=price_PASTE_YOUR_STRIPE_PRICE_ID_HERE

# ==============================================================================
# 15. ERROR MONITORING
# ==============================================================================
# DSN only. The Sentry `environment` is read from import.meta.env.MODE by
# src/utils/monitoring.ts and src/config/monitoring.ts, so do NOT set
# VITE_SENTRY_ENVIRONMENT — nothing reads it and it silently does nothing.
VITE_SENTRY_DSN=https://PASTE_YOUR_SENTRY_DSN@oPASTE_YOUR_ORG.ingest.sentry.io/PASTE_YOUR_PROJECT_ID

# ==============================================================================
# 16. ANALYTICS / CDN
# ==============================================================================
VITE_ANALYTICS_ENDPOINT=https://analytics.wasel14.online/api/v1
VITE_CDN_URL=https://cdn.wasel14.online

# ==============================================================================
# 16b. APPLICATION INSIGHTS
# ==============================================================================
# Prefer connection string (modern). Instrumentation key is legacy fallback.
VITE_APP_INSIGHTS_CONNECTION_STRING=InstrumentationKey=PASTE_YOUR_KEY;IngestionEndpoint=https://PASTE_YOUR_REGION.in.applicationinsights.azure.com/
VITE_APP_INSIGHTS_KEY=

# ==============================================================================
# 16c. OPENTELEMETRY (OTLP HTTP)
# ==============================================================================
# Set to your OTLP collector endpoint to enable distributed tracing export.
# Compatible with Grafana Tempo, Jaeger, Honeycomb, Datadog OTLP, etc.
# Example: https://tempo.your-infra.io
# Leave empty to disable OTLP export (spans are still captured in-process).
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=
VITE_OTEL_SERVICE_NAME=wasel-web

# ==============================================================================
# 16d. CURRENCY
# ==============================================================================
VITE_CURRENCY_STORAGE_KEY=wasel-preferred-currency

# ==============================================================================
# 16e. CAPTCHA
# ==============================================================================
VITE_AUTH_CAPTCHA_PROVIDER=
VITE_AUTH_CAPTCHA_SITE_KEY=

# ==============================================================================
# 16f. SALT LABELS (Regional / UI display)
# ==============================================================================
VITE_FIND_RIDE_TRIP_SALT_LABEL=السلط
VITE_FIND_RIDE_SALT_LABEL=السلط
VITE_PACKAGES_SALT_LABEL=السلط
VITE_PACKAGE_TRACK_SALT_LABEL=السلط
VITE_PACKAGE_SEND_SALT_LABEL=السلط
VITE_MOBILITY_SALT_LABEL=salt
VITE_CORRIDOR_SALT_LABEL=السلط

# ==============================================================================
# 16g. EVENT BROKER — PUBLIC / SERVER HYBRID
# ==============================================================================
VITE_EVENT_BROKER_PROXY_URL=https://your-project.supabase.co/functions/v1/event-broker-proxy
# NOTE: VITE_EVENT_BROKER_WORKER_SECRET is a browser-visible shared token used
# to authenticate event-broker-proxy calls from the client. It is NOT a server
# secret — it is intentionally VITE_* prefixed. Treat it as a low-privilege
# API key, not a high-entropy secret. Rotate if exposed.
VITE_EVENT_BROKER_WORKER_SECRET=PASTE_YOUR_EVENT_BROKER_TOKEN_HERE
VITE_EVENT_BROKER=

# ==============================================================================
# 16h. GEO STREAM — PUBLIC
# ==============================================================================
VITE_GEO_STREAM_URL=

# ==============================================================================
# 16i. TELEMETRY — PUBLIC
# ==============================================================================
# Bearer token sent with every /api/telemetry flush to prevent unauthenticated
# metric injection. Generate with: openssl rand -hex 32
# Must match the token validated by the /api/telemetry Vercel function.
# NOTE: This is a browser-visible token (VITE_* prefix). It is intentionally
# public — it prevents anonymous metric injection, not secret data access.
VITE_TELEMETRY_TOKEN=PASTE_YOUR_TELEMETRY_TOKEN_HERE

# ==============================================================================
# 16j. BROWSER WORKERS — FEATURE FLAG
# ==============================================================================
# Set to true once all five domain workers are confirmed live as edge functions.
# This gates the in-browser worker pool off to eliminate the race condition
# with deployed edge workers on shared Postgres tables.
VITE_DISABLE_BROWSER_WORKERS=true

# ==============================================================================
# 16k. PRODUCTION METRICS — PUBLIC
# ==============================================================================
# Optional metrics sink read by src/platform/production-metrics.ts.
# Leave empty to keep metrics in-process only.
VITE_METRICS_ENDPOINT=

# ==============================================================================
# 17. COMMUNICATION WORKER — SERVER ONLY
# ==============================================================================
# Generate strong values using: openssl rand -hex 32
# In Vercel, set these in Project Settings → Environment Variables (Server-side only).
# ==============================================================================
COMMUNICATION_WORKER_SECRET=PASTE_YOUR_COMMUNICATION_WORKER_SECRET_HERE
COMMUNICATION_WEBHOOK_TOKEN=PASTE_YOUR_COMMUNICATION_WEBHOOK_TOKEN_HERE
WASEL_INTERNAL_HEALTH_TOKEN=PASTE_YOUR_WASEL_INTERNAL_HEALTH_TOKEN_HERE
OUTBOX_WORKER_SECRET=PASTE_YOUR_OUTBOX_WORKER_SECRET_HERE

COMMUNICATION_MAX_ATTEMPTS=5
COMMUNICATION_PROCESS_INLINE=false

# ==============================================================================
# 17b. REDIS (OPTIONAL SERVER-SIDE CACHE)
# ==============================================================================
# Optional Redis cache for server-side rate limiting, session storage, etc.
# In Vercel, set these in Project Settings → Environment Variables (Server-side only).
REDIS_URL=redis://your-redis-host:6379
REDIS_PASSWORD=

# ==============================================================================
# 18. RUNTIME SECURITY / CORS
# ==============================================================================
# Keep disabled unless explicitly required and strongly authenticated.
ENABLE_RUNTIME_ADMIN_ENDPOINTS=false

# Lets /communications/admin/apply-migrations and /moderation/admin/apply-migrations
# run DDL from a live function. MUST remain false (or unset) in production: schema
# changes ship through `supabase db push`. Only set true for a throwaway local stack.
ALLOW_RUNTIME_MIGRATIONS=false

# Trusted production browser origins only.
ALLOWED_ORIGINS=https://www.wasel14.online,https://wasel14.online

# MUST remain false in production.
ALLOW_LOCAL_ORIGINS=false

# ==============================================================================
# 19. CLIQ PAYMENTS (JORDAN)
# ==============================================================================
# In Vercel, set these in Project Settings → Environment Variables (Server-side only).
CLIQ_CHECKOUT_URL_TEMPLATE=https://payments.cliq.jo/checkout?tx={transactionId}&amount={amount}&currency={currency}&return_url={returnUrl}
CLIQ_API_BASE_URL=https://api.cliq.jo/v1
CLIQ_MERCHANT_ID=PASTE_YOUR_CLIQ_MERCHANT_ID_HERE
CLIQ_API_KEY=PASTE_YOUR_CLIQ_API_KEY_HERE
CLIQ_WEBHOOK_SECRET=PASTE_YOUR_CLIQ_WEBHOOK_SECRET_HERE
# Required after verifying a signed CliQ sandbox event: use exactly `jod` or `fils`.
CLIQ_WEBHOOK_AMOUNT_UNIT=

# ==============================================================================
# ==============================================================================
# In Vercel, set these in Project Settings → Environment Variables (Server-side only).

# ==============================================================================
# 21. EMAIL — SERVER ONLY
# ==============================================================================
# Backend must explicitly validate supported provider values.
EMAIL_PROVIDER=resend

# ------------------------------------------------------------------------------
# RESEND (Primary)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_live_PASTE_YOUR_RESEND_API_KEY_HERE
RESEND_FROM_EMAIL=Wasel <notifications@wasel14.online>
RESEND_REPLY_TO_EMAIL=support@wasel14.online

# ------------------------------------------------------------------------------
# SENDGRID (Backup)
# ------------------------------------------------------------------------------
SENDGRID_API_KEY=SG.PASTE_YOUR_SENDGRID_API_KEY_HERE
SENDGRID_FROM_EMAIL=notifications@wasel14.online

# ==============================================================================
# 22. TWILIO — SERVER ONLY
# ==============================================================================
# In Vercel, set these in Project Settings → Environment Variables (Server-side only).
# ==============================================================================
TWILIO_ACCOUNT_SID=AC_PASTE_YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=PASTE_YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_VERIFY_SERVICE_SID=VA_PASTE_YOUR_TWILIO_VERIFY_SERVICE_SID_HERE
TWILIO_MESSAGING_SERVICE_SID=MG_PASTE_YOUR_TWILIO_MESSAGING_SERVICE_SID_HERE

# Optional when using a Messaging Service.
TWILIO_SMS_FROM=+962790000000
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Dev-only escape hatch: when set to 'true', phone verification codes are
# generated locally instead of being delivered by Twilio. The code is logged
# server-side and returned in the API response (devCode). NEVER enable this in
# production — it bypasses real SMS delivery.
# PHONE_OTP_DEV_MODE=true

# ==============================================================================
# 23. SUPABASE AUTH SMS / TWILIO
# ==============================================================================
# In Vercel, set these in Project Settings → Environment Variables (Server-side only).
# ==============================================================================
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_VERIFY_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# Secret used by Supabase Auth to sign the send_sms hook webhook (Standard Webhooks format).
# Configured in Supabase Dashboard → Authentication → Hooks → send_sms.
# Must match the SUPABASE_AUTH_HOOK_SEND_SMS_SECRET set in Supabase Edge Function secrets.
SEND_SMS_HOOK_SECRET=
SUPABASE_AUTH_HOOK_SEND_SMS_SECRET=

# ==============================================================================
# 24. DEPLOYMENT VALIDATION REQUIREMENTS
# ==============================================================================
# CI/CD SHOULD FAIL THE DEPLOYMENT WHEN:
#   - A required environment variable is missing.
#   - A required value is empty.
#   - A required value contains placeholder text.
#   - A server secret is exposed through VITE_*.
#   - Production enables demo data.
#   - Production enables synthetic trips.
#   - Production enables direct Supabase fallback.
#   - Production allows unrestricted local origins.
#   - Production enables unauthenticated admin endpoints.
#
# CODEBASE AUDIT SHOULD VERIFY:
#   - Every import.meta.env.* variable exists or is intentionally optional.
#   - Every process.env.* variable exists or is intentionally optional.
#   - Unused variables are removed.
#   - Edge Functions have their required Supabase secrets configured separately.
#   - Browser keys have provider-level restrictions.
# ==============================================================================

# ==============================================================================
# END OF WASEL ENVIRONMENT CONFIGURATION
# ==============================================================================
