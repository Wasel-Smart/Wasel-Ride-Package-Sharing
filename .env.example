# ==============================================================================
# 0. SECRETS LOCATION — EXTERNAL ENVIRONMENT DIRECTORY
# ==============================================================================
# DO NOT store real secrets inside this project folder if it is synced by
# OneDrive, Dropbox, Google Drive, or any cloud-sync service.
#
# To load env from outside the project tree, set the WASEL_ENV_DIR environment
# variable before starting the dev server or building:
#
#   PowerShell:  $env:WASEL_ENV_DIR="$env:USERPROFILE\.wasel-secrets"
#   Bash:        export WASEL_ENV_DIR="$HOME/.wasel-secrets"
#   Vercel:      Project Settings → Environment Variables → WASEL_ENV_DIR
#
# Place your real .env file in that directory. Vite will load .env,
# .env.local, .env.production, etc. from there instead of the project root.
#
# On Windows, create the directory once:
#   mkdir $env:USERPROFILE\.wasel-secrets
#   Copy your real .env into that directory.
#   Replace the contents of this project's .env with placeholders only.
# ==============================================================================

# ==============================================================================
# WASEL — ENVIRONMENT CONFIGURATION
# ==============================================================================
# PURPOSE
# ------------------------------------------------------------------------------
# Central environment variable template for the Wasel platform.
#
# FILE USAGE
# ------------------------------------------------------------------------------
# .env.example  → Safe template committed to Git. NO real secrets.
# .env.local    → Local development secrets. NEVER commit.
# Production    → Configure secrets in Vercel / Supabase Edge Function Secrets.
#
# SECURITY RULES
# ------------------------------------------------------------------------------
# 1. VITE_* variables are PUBLIC and available in the browser.
# 2. NEVER place server secrets in VITE_* variables.
# 3. NEVER commit real production secrets to Git.
# 4. Restrict browser API keys at the provider level.
# 5. Use separate credentials for development, staging, and production.
# 6. Rotate any secret that has ever been accidentally exposed.
# ==============================================================================

# ==============================================================================
# 1. ENVIRONMENT
# ==============================================================================
APP_ENV=production
LOG_LEVEL=info

# ==============================================================================
# 2. APPLICATION
# ==============================================================================
VITE_APP_NAME=Wasel

# Canonical production URL
VITE_APP_URL=https://www.wasel14.online
VITE_APP_ORIGIN=https://www.wasel14.online

# Legacy / redirect compatibility
VITE_APP_LEGACY_ORIGIN=https://wasel14.online

# Server-side canonical base URL
APP_BASE_URL=https://www.wasel14.online

# Set automatically by CI/CD when possible.
VITE_APP_VERSION=

# ==============================================================================
# 3. SUPABASE — PUBLIC BROWSER CONFIGURATION
# ==============================================================================
# These values are intentionally available to the browser.
# Supabase authorization security must be enforced through RLS policies.
# ==============================================================================
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Primary modern Supabase browser key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY_HERE

# ==============================================================================
# 4. SUPABASE — LEGACY CLIENT COMPATIBILITY
# ==============================================================================
# Keep ONLY while application code still uses import.meta.env.VITE_SUPABASE_ANON_KEY.
# If unused, remove this variable and migrate all clients to VITE_SUPABASE_PUBLISHABLE_KEY.
# ==============================================================================
VITE_SUPABASE_ANON_KEY=PASTE_YOUR_SUPABASE_ANON_KEY_HERE

# ==============================================================================
# 5. SUPABASE — SERVER ONLY
# ==============================================================================
# NEVER expose these variables through VITE_*.
# In Vercel, set these in Project Settings → Environment Variables (Server-side only).
# ==============================================================================
SUPABASE_SECRET_KEY=PASTE_YOUR_SUPABASE_SECRET_KEY_HERE

# Legacy compatibility only. Remove after migration if not required.
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Legacy JWT secret. Leave empty unless explicitly required by backend code.
SUPABASE_JWT_SECRET=PASTE_YOUR_SUPABASE_JWT_SECRET_HERE

# Public endpoint used for JWT/JWKS verification.
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json

# ==============================================================================
# 6. SUPABASE EDGE FUNCTIONS
# ==============================================================================
VITE_EDGE_FUNCTIONS_BASE_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1

# Optional. Leave empty to use the default function name from config.
VITE_EDGE_FUNCTION_NAME=make-server-0b1f4071

# Allowed values should be validated by the application.
VITE_DATA_PATH=edge

# ==============================================================================
# 7. APPLICATION API
# ==============================================================================
# Leave empty only if the application uses same-origin relative API routes.
VITE_API_URL=

# ==============================================================================
# 8. GOOGLE MAPS — PUBLIC BROWSER KEY
# ==============================================================================
# Restrict this key by HTTP referrers, production domains, and required Google APIs only.
VITE_GOOGLE_MAPS_API_KEY=PASTE_YOUR_GOOGLE_MAPS_API_KEY_HERE

# ==============================================================================
# 9. OAUTH — PUBLIC CLIENT CONFIGURATION
# ==============================================================================
# NOTE: VITE_GOOGLE_CLIENT_ID / VITE_FACEBOOK_APP_ID are NOT read by the web app
# (Supabase Auth runs the OAuth flow server-side via supabase-js signInWithOAuth).
# They are kept only because some deploy scripts copy them to Vercel.
# The real OAuth credentials are the SUPABASE_AUTH_* values below — read by Supabase,
# never exposed to the browser. Do NOT rely on the VITE_* vars for login to work.
VITE_GOOGLE_CLIENT_ID=PASTE_YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com
VITE_FACEBOOK_APP_ID=PASTE_YOUR_FACEBOOK_APP_ID_HERE
VITE_AUTH_CALLBACK_PATH=/app/auth/callback

# ==============================================================================
# 10. OAUTH — SERVER ONLY
# ==============================================================================
# In Vercel, set these in Project Settings → Environment Variables (Server-side only).
# ==============================================================================
SUPABASE_AUTH_GOOGLE_CLIENT_ID=PASTE_YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com
SUPABASE_AUTH_GOOGLE_CLIENT_SECRET=PASTE_YOUR_GOOGLE_CLIENT_SECRET_HERE
SUPABASE_AUTH_FACEBOOK_CLIENT_ID=PASTE_YOUR_FACEBOOK_APP_ID_HERE
SUPABASE_AUTH_FACEBOOK_CLIENT_SECRET=PASTE_YOUR_FACEBOOK_APP_SECRET_HERE

# ==============================================================================
# 11. SUPPORT CONTACTS
# ==============================================================================
# WhatsApp integrations generally expect digits only.
VITE_SUPPORT_WHATSAPP_NUMBER=962790000000
VITE_SUPPORT_EMAIL=support@wasel.jo

# E.164 format.
VITE_SUPPORT_PHONE_NUMBER=+962790000000
VITE_SUPPORT_SMS_NUMBER=+962790000000

# ==============================================================================
# 12. FEATURE FLAGS — PRODUCTION
# ==============================================================================
VITE_ENABLE_TWO_FACTOR_AUTH=false
VITE_ENABLE_EMAIL_NOTIFICATIONS=true
VITE_ENABLE_SMS_NOTIFICATIONS=true
VITE_ENABLE_WHATSAPP_NOTIFICATIONS=true

# Production safety flags.
VITE_ENABLE_DEMO_DATA=false
VITE_ENABLE_SYNTHETIC_TRIPS=false
VITE_ALLOW_DIRECT_SUPABASE_FALLBACK=false

# ==============================================================================
# 13. STRIPE — PUBLIC
# ==============================================================================
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_PASTE_YOUR_STRIPE_PUBLISHABLE_KEY_HERE

# ==============================================================================
# 14. STRIPE — SERVER ONLY
# ==============================================================================
# In Vercel, set these in Project Settings → Environment Variables (Server-side only).
STRIPE_SECRET_KEY=sk_live_PASTE_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_PASTE_YOUR_STRIPE_WEBHOOK_SECRET_HERE

# Validate against the installed Stripe SDK before enabling.
STRIPE_API_VERSION=2026-02-25.clover

# Stripe Billing price for the Wasel Plus monthly subscription.
STRIPE_WASEL_PLUS_PRICE_ID=price_PASTE_YOUR_STRIPE_PRICE_ID_HERE

# ==============================================================================
# 15. ERROR MONITORING
# ==============================================================================
VITE_SENTRY_DSN=https://PASTE_YOUR_SENTRY_DSN@oPASTE_YOUR_ORG.ingest.sentry.io/PASTE_YOUR_PROJECT_ID
VITE_SENTRY_ENVIRONMENT=production

# ==============================================================================
# 16. ANALYTICS / CDN
# ==============================================================================
VITE_ANALYTICS_ENDPOINT=https://analytics.wasel14.online/api/v1
VITE_CDN_URL=https://cdn.wasel14.online

# ==============================================================================
# 16b. APPLICATION INSIGHTS
# ==============================================================================
VITE_APP_INSIGHTS_KEY=

# ==============================================================================
# 16c. CURRENCY
# ==============================================================================
VITE_CURRENCY_STORAGE_KEY=wasel-preferred-currency

# ==============================================================================
# 16d. CAPTCHA
# ==============================================================================
VITE_AUTH_CAPTCHA_PROVIDER=
VITE_AUTH_CAPTCHA_SITE_KEY=

# ==============================================================================
# 16e. SALT LABELS (Regional / UI display)
# ==============================================================================
VITE_FIND_RIDE_TRIP_SALT_LABEL=السلط
VITE_FIND_RIDE_SALT_LABEL=السلط
VITE_PACKAGES_SALT_LABEL=السلط
VITE_PACKAGE_TRACK_SALT_LABEL=السلط
VITE_PACKAGE_SEND_SALT_LABEL=السلط
VITE_MOBILITY_SALT_LABEL=salt
VITE_CORRIDOR_SALT_LABEL=السلط

# ==============================================================================
# 16f. EVENT BROKER — PUBLIC / SERVER HYBRID
# ==============================================================================
VITE_EVENT_BROKER_PROXY_URL=https://your-project.supabase.co/functions/v1/event-broker-proxy
VITE_EVENT_BROKER_WORKER_SECRET=replace-with-a-long-random-secret
VITE_EVENT_BROKER=

# ==============================================================================
# 16g. GEO STREAM — PUBLIC
# ==============================================================================
VITE_GEO_STREAM_URL=

# ==============================================================================
# 17. COMMUNICATION WORKER — SERVER ONLY
# ==============================================================================
# Generate strong values using: openssl rand -hex 32
# In Vercel, set these in Project Settings → Environment Variables (Server-side only).
# ==============================================================================
COMMUNICATION_WORKER_SECRET=PASTE_YOUR_COMMUNICATION_WORKER_SECRET_HERE
COMMUNICATION_WEBHOOK_TOKEN=PASTE_YOUR_COMMUNICATION_WEBHOOK_TOKEN_HERE
WASEL_INTERNAL_HEALTH_TOKEN=PASTE_YOUR_WASEL_INTERNAL_HEALTH_TOKEN_HERE

COMMUNICATION_MAX_ATTEMPTS=5
COMMUNICATION_PROCESS_INLINE=false

# ==============================================================================
# 18. RUNTIME SECURITY / CORS
# ==============================================================================
# Keep disabled unless explicitly required and strongly authenticated.
ENABLE_RUNTIME_ADMIN_ENDPOINTS=false

# Trusted production browser origins only.
ALLOWED_ORIGINS=https://www.wasel14.online,https://wasel14.online

# MUST remain false in production.
ALLOW_LOCAL_ORIGINS=false

# ==============================================================================
# 19. CLIQ PAYMENTS (JORDAN)
# ==============================================================================
# In Vercel, set these in Project Settings → Environment Variables (Server-side only).
CLIQ_CHECKOUT_URL_TEMPLATE=https://payments.cliq.jo/checkout?tx={transactionId}&amount={amount}&currency={currency}&return_url={returnUrl}
CLIQ_API_BASE_URL=https://api.cliq.jo/v1
CLIQ_MERCHANT_ID=PASTE_YOUR_CLIQ_MERCHANT_ID_HERE
CLIQ_API_KEY=PASTE_YOUR_CLIQ_API_KEY_HERE
CLIQ_WEBHOOK_SECRET=PASTE_YOUR_CLIQ_WEBHOOK_SECRET_HERE

# ==============================================================================
# 20. SANAD VERIFICATION
# ==============================================================================
# In Vercel, set these in Project Settings → Environment Variables (Server-side only).
SANAD_API_BASE_URL=https://api.sanad.jo/v1
SANAD_CLIENT_ID=PASTE_YOUR_SANAD_CLIENT_ID_HERE
SANAD_CLIENT_SECRET=PASTE_YOUR_SANAD_CLIENT_SECRET_HERE
SANAD_WEBHOOK_SECRET=PASTE_YOUR_SANAD_WEBHOOK_SECRET_HERE

# ==============================================================================
# 21. EMAIL — SERVER ONLY
# ==============================================================================
# Backend must explicitly validate supported provider values.
EMAIL_PROVIDER=resend

# ------------------------------------------------------------------------------
# RESEND (Primary)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_live_PASTE_YOUR_RESEND_API_KEY_HERE
RESEND_FROM_EMAIL=Wasel <notifications@wasel14.online>
RESEND_REPLY_TO_EMAIL=support@wasel14.online

# ------------------------------------------------------------------------------
# SENDGRID (Backup)
# ------------------------------------------------------------------------------
SENDGRID_API_KEY=SG.PASTE_YOUR_SENDGRID_API_KEY_HERE
SENDGRID_FROM_EMAIL=notifications@wasel14.online

# ==============================================================================
# 22. TWILIO — SERVER ONLY
# ==============================================================================
# In Vercel, set these in Project Settings → Environment Variables (Server-side only).
# ==============================================================================
TWILIO_ACCOUNT_SID=AC_PASTE_YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=PASTE_YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_VERIFY_SERVICE_SID=VA_PASTE_YOUR_TWILIO_VERIFY_SERVICE_SID_HERE
TWILIO_MESSAGING_SERVICE_SID=MG_PASTE_YOUR_TWILIO_MESSAGING_SERVICE_SID_HERE

# Optional when using a Messaging Service.
TWILIO_SMS_FROM=+962790000000
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ==============================================================================
# 23. SUPABASE AUTH SMS / TWILIO
# ==============================================================================
# In Vercel, set these in Project Settings → Environment Variables (Server-side only).
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_VERIFY_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# ==============================================================================
# 24. DEPLOYMENT VALIDATION REQUIREMENTS
# ==============================================================================
# CI/CD SHOULD FAIL THE DEPLOYMENT WHEN:
#   - A required environment variable is missing.
#   - A required value is empty.
#   - A required value contains placeholder text.
#   - A server secret is exposed through VITE_*.
#   - Production enables demo data.
#   - Production enables synthetic trips.
#   - Production enables direct Supabase fallback.
#   - Production allows unrestricted local origins.
#   - Production enables unauthenticated admin endpoints.
#
# CODEBASE AUDIT SHOULD VERIFY:
#   - Every import.meta.env.* variable exists or is intentionally optional.
#   - Every process.env.* variable exists or is intentionally optional.
#   - Unused variables are removed.
#   - Edge Functions have their required Supabase secrets configured separately.
#   - Browser keys have provider-level restrictions.
# ==============================================================================

# ==============================================================================
# END OF WASEL ENVIRONMENT CONFIGURATION
# ==============================================================================
