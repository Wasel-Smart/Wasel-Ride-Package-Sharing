/supabase/

# Development files
.env
.env.*
!.env.example
!.env.production

# Dependencies
node_modules/

# Build artifacts
.vite/
coverage/
dist/

# Documentation
docs/
*.md
!README.md

# Git
.git/
.github/

# IDE
.vscode/
.idea/

# Docker
docker/
Dockerfile
docker-compose*.yml

