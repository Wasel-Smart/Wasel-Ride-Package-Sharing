{
    "name": "wasel-web",
    "private": true,
    "overrides": {
        "eslint-plugin-react-hooks": "^7.1.1"
    },
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build && node scripts/generate-pwa-manifest.mjs && node scripts/version-sw.mjs",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:oauth": "playwright test --grep @oauth",
        "test:visual": "playwright test --grep @visual",
        "test:visual:update": "playwright test --grep @visual --update-snapshots",
        "bundle:analyze": "vite build --mode analyze",
        "test:load:smoke": "k6 run tests/load/k6-smoke.js",
        "type-check:app": "tsc -p tsconfig.build.json --noEmit",
        "type-check:test": "tsc -p tsconfig.tests.json --noEmit",
        "type-check:api": "tsc -p tsconfig.api.json --noEmit",
        "type-check": "npm run type-check:app && npm run type-check:test && npm run type-check:api",
        "supabase:start": "supabase start",
        "supabase:stop": "supabase stop",
        "supabase:db:reset": "supabase db reset",
        "supabase:status": "supabase status",
        "verify:contracts": "node scripts/verify-contracts.js",
        "verify:oauth": "node scripts/verify-oauth-config.mjs",
        "verify:ci": "npm run type-check && npm run lint && npm run test:unit && node scripts/verify-translations.mjs",
        "verify": "npm run verify:ci && npm run build && npm run test:e2e",
        "audit:rbac": "node scripts/audit-rbac.mjs",
        "sweep:i18n": "node scripts/sweep-i18n.mjs",
        "cleanup:root": "node scripts/cleanup-root.mjs",
        "brand:check": "node scripts/brand-check.mjs",
        "brand:sync": "node scripts/sync-brand-assets.mjs"
    },
    "dependencies": {
        "@microsoft/applicationinsights-web": "^3.4.3",
        "@radix-ui/react-accordion": "^1.2.3",
        "@radix-ui/react-alert-dialog": "^1.1.6",
        "@radix-ui/react-aspect-ratio": "^1.1.2",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-context-menu": "^2.2.6",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-hover-card": "^1.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-menubar": "^1.1.6",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-popover": "^1.1.6",
        "@radix-ui/react-progress": "^1.1.2",
        "@radix-ui/react-radio-group": "^1.2.3",
        "@radix-ui/react-scroll-area": "^1.2.3",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slider": "^1.2.3",
        "@radix-ui/react-slot": "^1.1.2",
        "@radix-ui/react-switch": "^1.1.3",
        "@radix-ui/react-tabs": "^1.1.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@sentry/react": "^8.0.0",
        "@stripe/stripe-js": "^4.0.0",
        "@supabase/ssr": "^0.12.4",
        "@supabase/supabase-js": "^2.112.3",
        "@tanstack/react-query": "^5.45.1",
        "@vercel/speed-insights": "^2.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^3.0.0",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.4.2",
        "leaflet": "^1.9.4",
        "lucide-react": "^0.487.0",
        "motion": "^12.0.0",
        "react": "^19.2.8",
        "react-day-picker": "^8.10.1",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.55.0",
        "react-resizable-panels": "^2.1.7",
        "react-router": "^7.18.3",
        "recharts": "^2.15.2",
        "sonner": "^2.0.3",
        "tailwind-merge": "^3.5.0",
        "tslib": "^2.1.0",
        "tw-animate-css": "^1.3.8",
        "vaul": "^1.1.2",
        "web-vitals": "^5.2.0",
        "workbox-window": "^7.4.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.44.1",
        "@tailwindcss/vite": "^4.1.4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/deno": "^2.7.0",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^20.19.0",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@vitejs/plugin-react": "^4.7.0",
        "autoprefixer": "^10.4.19",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.4.7",
        "globals": "^16.5.0",
        "jsdom": "^29.1.1",
        "postcss": "^8.4.38",
        "rollup-plugin-visualizer": "^7.0.1",
        "tailwindcss": "^4.1.4",
        "typescript": "^5.4.5",
        "typescript-eslint": "^8.66.0",
        "vite": "^6.0.0",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^3.2.6",
        "workbox-build": "^7.4.1"
    }
}
