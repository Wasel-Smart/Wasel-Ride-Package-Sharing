{
  "name": "wasel-web",
  "private": true,
  "overrides": {
    "express": "^5.1.0",
    "bl": "^2.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "basic-ftp": "^6.2.3",
    "tmp": "^0.2.7",
    "uuid": "^14.0.3",
    "extract-zip": "^2.0.1",
    "sprintf-js": "^1.1.3",
    "@puppeteer/browsers": "^3.2.4",
    "puppeteer-core": "^25.13.0",
    "lighthouse": "^13.5.0",
    "js-yaml": "^5.4.3"
  },
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored --ignore-pattern 'mobile/**'"
    ],
    "*.{js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored --ignore-pattern 'mobile/**'"
    ]
  },
  "scripts": {
    "predev": "node scripts/generate-locale-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/verify-supabase-key.mjs && node scripts/generate-locale-assets.mjs",
    "verify:supabase-key": "node scripts/verify-supabase-key.mjs",
    "build": "tsc && vite build && node scripts/generate-pwa-manifest.mjs && node scripts/version-sw.mjs",
    "lint": "eslint src tests --ext .ts,.tsx --report-unused-disable-directives",
    "lint:typescript": "eslint src tests --ext .ts,.tsx --report-unused-disable-directives",
    "preview": "vite preview",
    "test:unit": "node scripts/generate-locale-assets.mjs && vitest run",
    "test:unit:watch": "node scripts/generate-locale-assets.mjs && vitest",
    "test:edge": "node scripts/run-edge-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:oauth": "playwright test --grep @oauth",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "bundle:analyze": "vite build --mode analyze",
    "test:load:smoke": "k6 run tests/load/k6-smoke.js",
    "test:load:realistic": "k6 run tests/load/k6-realistic.js",
    "test:load:soak": "k6 run tests/load/k6-soak.js",
    "test:load:production": "k6 run tests/load/k6-production.js",
    "test:contracts": "vitest run tests/integration/openapi-contract.test.ts tests/integration/api-endpoints-contract.test.ts && npm run verify:contracts",
    "test:contracts:live": "npm run test:contracts && node scripts/verify-frontend-backend-wiring.mjs",
    "type-check:app": "tsc -p tsconfig.build.json --noEmit",
    "type-check:test": "tsc -p tsconfig.tests.json --noEmit",
    "type-check:api": "tsc -p tsconfig.api.json --noEmit",
    "type-check": "node scripts/generate-locale-assets.mjs && npm run type-check:app && npm run type-check:test && npm run type-check:api",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:db:reset": "supabase db reset",
    "supabase:status": "supabase status",
    "verify:contracts": "node scripts/verify-contracts.js",
    "verify:oauth": "node scripts/verify-oauth-config.mjs",
    "verify:coverage": "node scripts/generate-locale-assets.mjs && vitest run --coverage",
    "verify:ci": "npm run type-check && npm run lint && npm run verify:coverage && node scripts/verify-translations.mjs && npm run check:routes && npm run secrets:check && npm run env:check && npm run edge:check && npm run test:contracts",
    "verify": "npm run verify:ci && npm run build && npm run test:e2e",
    "audit:rbac": "node scripts/audit-rbac.mjs",
    "sweep:i18n": "node scripts/sweep-i18n.mjs",
    "cleanup:root": "node scripts/cleanup-root.mjs",
    "brand:check": "node scripts/brand-check.mjs",
    "brand:check:strict": "node scripts/brand-check.mjs --strict",
    "lighthouse": "npx @lhci/cli autorun --config=lighthouserc.js",
    "brand:sync": "node scripts/sync-brand-assets.mjs",
    "secrets:check": "node scripts/validate-no-secrets.mjs",
    "credentials:inventory": "node scripts/audit-credential-names.mjs",
    "env:check": "node scripts/check-env-exposure.mjs",
    "edge:check": "npm run edge:sync:check && npm run edge:graph && npm run edge:types",
    "verify:wiring": "node scripts/verify-frontend-backend-wiring.mjs",
    "check:routes": "node scripts/check-route-contract.mjs",
    "secrets:migrate": "node scripts/migrate-secrets-offsite.mjs",
    "secrets:move-offsite": "powershell -ExecutionPolicy Bypass -File scripts/move-env-offsite.ps1",
    "env:validate-vercel": "node scripts/validate-vercel-env.mjs",
    "env:validate-vercel:strict": "node scripts/validate-vercel-env.mjs --strict",
    "env:validate-vercel:hints": "node scripts/validate-vercel-env.mjs --fix-hints",
    "preflight": "node scripts/production-preflight.mjs",
    "edge:sync": "node scripts/prepare-edge-bundles.mjs",
    "edge:sync:check": "node scripts/prepare-edge-bundles.mjs --check",
    "edge:graph": "node scripts/check-edge-module-graph.mjs",
    "edge:types": "node scripts/check-edge-types.mjs",
    "edge:deploy": "npm run edge:sync && npm run edge:graph && npm run edge:types && supabase functions deploy $EDGE_FUNCTION_NAME --project-ref $SUPABASE_PROJECT_REF"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@microsoft/applicationinsights-web": "^3.4.4",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
