# ============================================================================
# WASEL PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# CRITICAL: This file contains production-ready configuration structure.
# Copy to .env.production and fill with actual production values.
# NEVER commit actual secrets to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# SUPABASE PRODUCTION
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://zexlxabdcsjefptmjhuq.supabase.co
# Publishable key format (sb_publishable_...). Legacy eyJ... JWT anon keys are
# deprecated by Supabase; do not paste a JWT here.
VITE_SUPABASE_ANON_KEY=<sb_publishable_YOUR_KEY_HERE>
VITE_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_YOUR_KEY_HERE>
# Server-only. Never VITE_-prefixed.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY_HERE

# Edge Function Configuration
VITE_EDGE_FUNCTION_NAME=make-server-0b1f4071
VITE_EDGE_FUNCTIONS_BASE_URL=https://zexlxabdcsjefptmjhuq.supabase.co/functions/v1
VITE_API_URL=https://zexlxabdcsjefptmjhuq.supabase.co/functions/v1/make-server-0b1f4071

# ----------------------------------------------------------------------------
# APPLICATION URLS
# ----------------------------------------------------------------------------
VITE_APP_URL=https://www.wasel14.online
VITE_APP_NAME=Wasel
VITE_CDN_URL=https://cdn.wasel14.online
VITE_ANALYTICS_ENDPOINT=https://analytics.wasel14.online/api/v1

# ----------------------------------------------------------------------------
# AUTHENTICATION & OAUTH
# ----------------------------------------------------------------------------
VITE_AUTH_CALLBACK_PATH=/app/auth/callback

# Google OAuth Production
# VITE_GOOGLE_CLIENT_ID is copied to Vercel by deploy scripts but is NOT consumed by
# the web app. Supabase Auth handles OAuth server-side. The SUPABASE_AUTH_* values
# below are the actual credentials used (never exposed to the browser).
# Must match the OAuth client actually configured in Supabase ? Authentication ?
# Providers ? Google, which is the same client as in .env.example.
VITE_GOOGLE_CLIENT_ID=631682127784-4n5b1g3mo934bp3jnm7501i9d60t2im2.apps.googleusercontent.com
SUPABASE_AUTH_GOOGLE_CLIENT_ID=631682127784-4n5b1g3mo934bp3jnm7501i9d60t2im2.apps.googleusercontent.com
SUPABASE_AUTH_GOOGLE_CLIENT_SECRET=GOCSPX-your-secret-here

# Facebook OAuth Production
# Same caveat: VITE_FACEBOOK_APP_ID is not read by the web app; SUPABASE_AUTH_* is.
VITE_FACEBOOK_APP_ID=2154021471813673
SUPABASE_AUTH_FACEBOOK_CLIENT_ID=2154021471813673
SUPABASE_AUTH_FACEBOOK_CLIENT_SECRET=placeholder-change-me

# REQUIRED in Google Cloud (Authorized redirect URIs) and Facebook for Developers
# (Valid OAuth Redirect URIs), verbatim, or the provider answers
# `redirect_uri_mismatch` before the user ever reaches this app:
#   https://<your-project-ref>.supabase.co/auth/v1/callback
# See .env.example section 9 for the full explanation.

# ----------------------------------------------------------------------------
# MAPS & GEOLOCATION
# ----------------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=AIzaSyC-your-production-maps-key

