# ----------------------------------------------------------------------------
REDIS_URL=redis://your-redis-host:6379
REDIS_PASSWORD=your-redis-password
REDIS_TLS_ENABLED=true

# ----------------------------------------------------------------------------
# CDN & ASSET OPTIMIZATION
# ----------------------------------------------------------------------------
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_API_TOKEN=your-cloudflare-token

# ----------------------------------------------------------------------------
# BACKUP & DISASTER RECOVERY
# ----------------------------------------------------------------------------
BACKUP_S3_BUCKET=wasel-backups-prod
BACKUP_S3_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ----------------------------------------------------------------------------
# BUILD & DEPLOYMENT
# ----------------------------------------------------------------------------
# MODE is set by Vite from --mode; setting it here has no effect and only
# confuses readers. VITE_MODE is the one src/utils/env reads as a fallback.
VITE_MODE=production
APP_BASE_URL=https://www.wasel14.online

# Source maps are controlled by `build.sourcemap` in vite.config.ts, not by env.
# There are no VITE_GENERATE_SOURCEMAP / VITE_SOURCEMAP_UPLOAD_ONLY readers in
# the codebase, so they are deliberately not listed here.
