{
  "expo": {
    "name": "Wasel",
    "slug": "wasel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wasel",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#06111b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wasel.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "يستخدم واصل موقعك للعثور على المشاوير القريبة وإظهار موقعك على الخريطة. Wasel uses your location to find nearby rides and show your position on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "يستخدم واصل موقعك أثناء الرحلة النشطة لتحديث موقع السائق بأمان. Wasel uses your location during an active trip to update the driver's position safely."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#06111b"
      },
      "package": "com.wasel.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#00C8E8",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يحتاج واصل إلى موقعك للعثور على المشاوير القريبة وعرض موقعك على الخريطة.",
          "locationAlwaysAndWhenInUsePermission": "يحتاج واصل إلى الموقع أثناء الرحلة النشطة للمطابقة والتتبع الآمن."
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "wasel-mobile-project"
      }
    }
  }
}
