#!/usr/bin/env bash
set -euo pipefail

# ---- Secret pattern guard ----
# Block commits that introduce real credentials matching known patterns.
# Catches: Supabase keys, Google API keys, OAuth client IDs with real project refs.
STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
if [ -n "$STAGED" ]; then
  # Collect added lines from staged diff. grep exits 1 when there are no matches
  # (e.g. delete-only hunks or all additions marked secretscan:allow); with
  # pipefail that must not abort the hook.
  DIFF=$(git diff --cached -U0 -- $STAGED | { grep -E '^\+' || true; } | { grep -vE '^\+\+\+' || true; } | { grep -vE 'secretscan:allow' || true; })

  # Supabase publishable/anon keys (sb_publishable_...)
  if printf '%s\n' "$DIFF" | grep -qE 'sb_publishable_[A-Za-z0-9_-]{20,}'; then
    echo "[pre-commit] ERROR: Supabase key detected in staged changes. Remove it before committing."
    exit 1
  fi
  # Google API keys (AIza...)
  if printf '%s\n' "$DIFF" | grep -qE 'AIza[0-9A-Za-z_-]{35}'; then
    echo "[pre-commit] ERROR: Google API key detected in staged changes. Remove it before committing."
    exit 1
  fi
  # Supabase project ref URLs (*.supabase.co with a real project ref)
  if printf '%s\n' "$DIFF" | grep -qE 'https://[a-z]{20}\.supabase\.co'; then
    echo "[pre-commit] ERROR: Supabase project URL detected in staged changes. Use a placeholder instead."
    exit 1
  fi
fi

# Run lint-staged: only lints and type-checks files staged for this commit.
# Full test suite runs in CI (on push/PR), not on every local commit.
#
# lint-staged intentionally fails ("Prevented an empty git commit!") when its
# tasks (eslint --fix) revert every staged change back to HEAD, leaving nothing
# to commit. That is correct behaviour — we must NOT pass --allow-empty or
# --no-verify. We only improve the diagnostic so the reason is obvious, and we
# still reject the commit (non-zero exit) so no empty/fixed-away commit slips in.
set +e
npx --no-install lint-staged
LINT_RC=$?
set -e

if [ "$LINT_RC" -ne 0 ]; then
  # If nothing is staged any more, ESLint reverted all staged content to HEAD
  # (genuine empty commit). A real lint error would have restored the user's
  # staged content, so the staged diff would still be non-empty.
  if [ -z "$(git diff --cached --name-only)" ]; then
    echo ""
    echo "[pre-commit] All staged changes were auto-fixed back to HEAD by ESLint --fix."
    echo "[pre-commit] There is nothing left to commit — refusing to create an empty commit."
    echo "[pre-commit] Fix the underlying lint issue, unstage the file, or make a substantive change:"
    echo "[pre-commit]   git restore --staged <file>"
    echo "[pre-commit] (lint-staged is working as intended; no hook bypass was used.)"
  fi
  exit "$LINT_RC"
fi
