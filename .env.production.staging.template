# ==============================================================================
# WASEL — STAGING ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.production.staging and fill in staging-specific values.
# Use with: WASEL_ENV_DIR=. npm run dev  (or set WASEL_ENV_DIR in CI/CD)
# ==============================================================================

# ==============================================================================
# 1. APPLICATION
# ==============================================================================
VITE_APP_NAME=Wasel Staging
VITE_APP_URL=https://staging.wasel14.online
VITE_APP_ORIGIN=https://staging.wasel14.online

# ==============================================================================
# 2. SUPABASE — PUBLIC BROWSER CONFIGURATION
# ==============================================================================
# Use a separate Supabase project for staging, or the same project with
# separate auth redirect URLs allow-listed.
VITE_SUPABASE_URL=https://YOUR-STAGING-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_STAGING_PUBLISHABLE_KEY_HERE
VITE_SUPABASE_ANON_KEY=PASTE_YOUR_STAGING_SUPABASE_ANON_KEY_HERE

# ==============================================================================
# 3. SUPABASE EDGE FUNCTIONS
# ==============================================================================
VITE_EDGE_FUNCTIONS_BASE_URL=https://YOUR-STAGING-PROJECT-REF.supabase.co/functions/v1
VITE_EDGE_FUNCTION_NAME=make-server-0b1f4071

# ==============================================================================
# 4. APPLICATION API
# ==============================================================================
VITE_API_URL=

# ==============================================================================
# 5. GOOGLE MAPS — PUBLIC BROWSER KEY
# ==============================================================================
# Restrict this key by HTTP referrers to staging domains only.
VITE_GOOGLE_MAPS_API_KEY=PASTE_YOUR_STAGING_GOOGLE_MAPS_API_KEY_HERE

# ==============================================================================
# 6. OAUTH — PUBLIC CLIENT CONFIGURATION
# ==============================================================================
VITE_GOOGLE_CLIENT_ID=PASTE_YOUR_STAGING_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com
VITE_FACEBOOK_APP_ID=PASTE_YOUR_STAGING_FACEBOOK_APP_ID_HERE
VITE_AUTH_CALLBACK_PATH=/app/auth/callback

# ==============================================================================
# 7. SUPPORT CONTACTS
# ==============================================================================
VITE_SUPPORT_WHATSAPP_NUMBER=962790000000
VITE_SUPPORT_EMAIL=support-staging@wasel14.online
VITE_SUPPORT_PHONE_NUMBER=+962790000000
VITE_SUPPORT_SMS_NUMBER=+962790000000

# ==============================================================================
# 8. FEATURE FLAGS — STAGING
# ==============================================================================
# Enable test features in staging that are disabled in production.
VITE_ENABLE_TWO_FACTOR_AUTH=true
VITE_ENABLE_EMAIL_NOTIFICATIONS=true
VITE_ENABLE_SMS_NOTIFICATIONS=true
VITE_ENABLE_WHATSAPP_NOTIFICATIONS=true
VITE_ENABLE_DEMO_DATA=true
VITE_ENABLE_SYNTHETIC_TRIPS=true
VITE_ALLOW_DIRECT_SUPABASE_FALLBACK=false

# ==============================================================================
# 9. STRIPE — PUBLIC
# ==============================================================================
# Use Stripe test keys for staging.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_PASTE_YOUR_STRIPE_PUBLISHABLE_KEY_HERE

# ==============================================================================
# 10. STRIPE — SERVER ONLY
# ==============================================================================
STRIPE_SECRET_KEY=sk_test_PASTE_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_PASTE_YOUR_STRIPE_WEBHOOK_SECRET_HERE
STRIPE_API_VERSION=2026-02-25.clover

# ==============================================================================
# 11. ERROR MONITORING
# ==============================================================================
VITE_SENTRY_DSN=https://PASTE_YOUR_STAGING_SENTRY_DSN@oPASTE_YOUR_ORG.ingest.sentry.io/PASTE_YOUR_PROJECT_ID
VITE_SENTRY_ENVIRONMENT=staging

# ==============================================================================
# 12. CURRENCY
# ==============================================================================
VITE_CURRENCY_STORAGE_KEY=wasel-preferred-currency

# ==============================================================================
# 13. CAPTCHA
# ==============================================================================
VITE_AUTH_CAPTCHA_PROVIDER=
VITE_AUTH_CAPTCHA_SITE_KEY=

# ==============================================================================
# 14. SALT LABELS (Regional / UI display)
# ==============================================================================
VITE_FIND_RIDE_TRIP_SALT_LABEL=السلط
VITE_FIND_RIDE_SALT_LABEL=السلط
VITE_PACKAGES_SALT_LABEL=السلط
VITE_PACKAGE_TRACK_SALT_LABEL=السلط
VITE_PACKAGE_SEND_SALT_LABEL=السلط
VITE_MOBILITY_SALT_LABEL=salt
VITE_CORRIDOR_SALT_LABEL=السلط

# ==============================================================================
# 15. EVENT BROKER — PUBLIC / SERVER HYBRID
# ==============================================================================
VITE_EVENT_BROKER_PROXY_URL=https://YOUR-STAGING-PROJECT-REF.supabase.co/functions/v1/event-broker-proxy
VITE_EVENT_BROKER_WORKER_SECRET=replace-with-a-long-random-secret
VITE_EVENT_BROKER=

# ==============================================================================
# 16. GEO STREAM — PUBLIC
# ==============================================================================
VITE_GEO_STREAM_URL=

# ==============================================================================
# 17. COMMUNICATION WORKER — SERVER ONLY
# ==============================================================================
COMMUNICATION_WORKER_SECRET=PASTE_YOUR_STAGING_COMMUNICATION_WORKER_SECRET_HERE
COMMUNICATION_WEBHOOK_TOKEN=PASTE_YOUR_STAGING_COMMUNICATION_WEBHOOK_TOKEN_HERE
WASEL_INTERNAL_HEALTH_TOKEN=PASTE_YOUR_STAGING_WASEL_INTERNAL_HEALTH_TOKEN_HERE

COMMUNICATION_MAX_ATTEMPTS=5
COMMUNICATION_PROCESS_INLINE=false

# ==============================================================================
# 18. RUNTIME SECURITY / CORS
# ==============================================================================
ENABLE_RUNTIME_ADMIN_ENDPOINTS=false
ALLOWED_ORIGINS=https://staging.wasel14.online,https://www.staging.wasel14.online
ALLOW_LOCAL_ORIGINS=false

# ==============================================================================
# 19. CLIQ PAYMENTS (JORDAN)
# ==============================================================================
# Use CliQ sandbox/test credentials for staging.
CLIQ_CHECKOUT_URL_TEMPLATE=https://payments.cliq.jo/checkout?tx={transactionId}&amount={amount}&currency={currency}&return_url={returnUrl}
CLIQ_API_BASE_URL=https://api.cliq.jo/v1
CLIQ_MERCHANT_ID=PASTE_YOUR_STAGING_CLIQ_MERCHANT_ID_HERE
CLIQ_API_KEY=PASTE_YOUR_STAGING_CLIQ_API_KEY_HERE
CLIQ_WEBHOOK_SECRET=PASTE_YOUR_STAGING_CLIQ_WEBHOOK_SECRET_HERE

# ==============================================================================
# 20. SANAD VERIFICATION
# ==============================================================================
SANAD_API_BASE_URL=https://api.sanad.jo/v1
SANAD_CLIENT_ID=PASTE_YOUR_STAGING_SANAD_CLIENT_ID_HERE
SANAD_CLIENT_SECRET=PASTE_YOUR_STAGING_SANAD_CLIENT_SECRET_HERE
SANAD_WEBHOOK_SECRET=PASTE_YOUR_STAGING_SANAD_WEBHOOK_SECRET_HERE

# ==============================================================================
# 21. EMAIL — SERVER ONLY
# ==============================================================================
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_test_PASTE_YOUR_STAGING_RESEND_API_KEY_HERE
RESEND_FROM_EMAIL=Wasel Staging <notifications-staging@wasel14.online>
RESEND_REPLY_TO_EMAIL=support-staging@wasel14.online

# ==============================================================================
# 22. TWILIO — SERVER ONLY
# ==============================================================================
TWILIO_ACCOUNT_SID=AC_PASTE_YOUR_STAGING_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=PASTE_YOUR_STAGING_TWILIO_AUTH_TOKEN_HERE
TWILIO_VERIFY_SERVICE_SID=VA_PASTE_YOUR_STAGING_TWILIO_VERIFY_SERVICE_SID_HERE
TWILIO_MESSAGING_SERVICE_SID=MG_PASTE_YOUR_STAGING_TWILIO_MESSAGING_SERVICE_SID_HERE
TWILIO_SMS_FROM=+962790000000
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ==============================================================================
# 23. SUPABASE AUTH SMS / TWILIO
# ==============================================================================
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_VERIFY_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# ==============================================================================
# 24. DEPLOYMENT VALIDATION REQUIREMENTS
# ==============================================================================
# CI/CD SHOULD FAIL THE DEPLOYMENT WHEN:
#   - A required environment variable is missing.
#   - A required value is empty.
#   - A required value contains placeholder text.
#   - A server secret is exposed through VITE_*.
#   - Staging enables unauthenticated admin endpoints.
# ==============================================================================

# ==============================================================================
# END OF WASEL STAGING ENVIRONMENT CONFIGURATION
# ==============================================================================
